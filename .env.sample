S4_AES_ENCRYPTION_KEY=
#DB User
DB_KULLANICI=
#DB Password
DB_SIFRE=

# ─── Mail Ayarları (Fallback : SMTP_SIFRE, SMTP_AWS_K_ADI, SMTP_AWS_SIFRE) ───
# NOT: Mail ayarları öncelikle Admin Paneli > Genel Ayarlar üzerinden yönetilir.
# Buradaki değerler sadece veritabanında ayar bulunamazsa yedek olarak kullanılır.
#SMTP Password
SMTP_SIFRE=
#SMTP AWS Key (if AWS SES available)
