#Microsoft Translator Key
MICROSOFT_TRANSLATOR_KEY=
#Microsoft Translator Region
MICROSOFT_TRANSLATOR_REGION=
#DeepL API Key
DEEPL_API_KEY=
# Development environment (local, production)
APP_ENV=
# Update Path
UPDATE_PATH=https://n0n1.tr/update/websistem

# ─── PREMIUM / LICENSE OPTIONS ───────────────────────────────────────────────
